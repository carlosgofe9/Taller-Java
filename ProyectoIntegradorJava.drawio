  <diagram name="Página-1" id="6QaB4zwMRdlIx0CNwTlq">
    <mxGraphModel dx="3920" dy="2304" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml RetailService_Class_Diagram\n\nskinparam classAttributeIconSize 0\nskinparam monochrome false\nskinparam shadowing true\nskinparam packageStyle rectangle\n\npackage \&quot;com.axity.curso.retailservice\&quot; {\n\n    package \&quot;model\&quot; {\n        class Product {\n            - id: Long\n            - name: String\n            - description: String\n            - price: BigDecimal\n            - stock: Integer\n            - category: String\n            - sku: String\n            - active: Boolean\n        }\n\n        class Order {\n            - id: Long\n            - customerEmail: String\n            - orderDate: LocalDateTime\n            - totalAmount: BigDecimal\n            - status: OrderStatus\n            - items: List&lt;OrderItem&gt;\n        }\n\n        class OrderItem {\n            - id: Long\n            - product: Product\n            - quantity: Integer\n            - unitPrice: BigDecimal\n        }\n\n        enum OrderStatus {\n            EN_PROCESO\n            COMPLETADO\n            CANCELADO\n        }\n\n        Order \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItem : contiene\n        OrderItem \&quot;*\&quot; --&gt; \&quot;1\&quot; Product : refiere\n        Order --&gt; OrderStatus\n    }\n\n    package \&quot;dto\&quot; {\n        class ProductDTO {\n            - id: Long\n            - name: String\n            - description: String\n            - price: BigDecimal\n            - stock: Integer\n            - category: String\n            - sku: String\n            - active: Boolean\n        }\n\n        class OrderRequestDTO {\n            - cliente: String\n            - items: List&lt;OrderItemRequestDTO&gt;\n        }\n\n        class OrderItemRequestDTO {\n            - productId: Long\n            - cantidad: Integer\n        }\n\n        class OrderResponseDTO {\n            - id: Long\n            - customerEmail: String\n            - status: OrderStatus\n            - total: BigDecimal\n            - items: List&lt;OrderItemResponseDTO&gt;\n        }\n\n        class OrderItemResponseDTO {\n            - productId: Long\n            - cantidad: Integer\n        }\n\n        OrderRequestDTO \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItemRequestDTO\n        OrderResponseDTO \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItemResponseDTO\n    }\n\n    package \&quot;repository\&quot; {\n        interface ProductRepository {\n            + findBySku(sku: String): Optional&lt;Product&gt;\n            + findByActiveTrue(): List&lt;Product&gt;\n        }\n\n        interface OrderRepository {\n            + findByCustomerEmail(email: String): List&lt;Order&gt;\n        }\n\n        interface OrderItemRepository {\n        }\n    }\n\n    package \&quot;service\&quot; {\n        interface ProductService {\n            + crearProducto(dto: ProductDTO): ProductDTO\n            + listarProductos(): List&lt;ProductDTO&gt;\n            + obtenerPorId(id: Long): ProductDTO\n            + actualizarProducto(id: Long, dto: ProductDTO): ProductDTO\n            + eliminarProducto(id: Long): void\n        }\n\n        class ProductServiceImpl implements ProductService {\n            - productRepository: ProductRepository\n        }\n\n        interface OrderService {\n            + crearPedido(dto: OrderRequestDTO): OrderResponseDTO\n            + listarPedidos(): List&lt;OrderResponseDTO&gt;\n            + obtenerPorId(id: Long): OrderResponseDTO\n            + cancelarPedido(id: Long): OrderResponseDTO\n        }\n\n        class OrderServiceImpl implements OrderService {\n            - orderRepository: OrderRepository\n            - productRepository: ProductRepository\n            - notificationService: NotificationService\n        }\n\n        class NotificationService {\n            + enviarConfirmacionEmail(email: String, orderId: Long): void\n            + notificarStockBajo(sku: String, stockActual: Integer): void\n        }\n\n        ProductServiceImpl --&gt; ProductRepository\n        OrderServiceImpl --&gt; OrderRepository\n        OrderServiceImpl --&gt; ProductRepository\n        OrderServiceImpl --&gt; NotificationService\n    }\n\n    package \&quot;controller\&quot; {\n        class ProductController {\n            - productService: ProductService\n            + crearProducto(dto: ProductDTO): ResponseEntity&lt;ProductDTO&gt;\n            + listarProductos(): ResponseEntity&lt;List&lt;ProductDTO&gt;&gt;\n            + obtenerProductoPorId(id: Long): ResponseEntity&lt;ProductDTO&gt;\n            + actualizarProducto(id: Long, dto: ProductDTO): ResponseEntity&lt;ProductDTO&gt;\n            + eliminarProducto(id: Long): ResponseEntity&lt;Void&gt;\n        }\n\n        class OrderController {\n            - orderService: OrderService\n            + crearPedido(dto: OrderRequestDTO): ResponseEntity&lt;OrderResponseDTO&gt;\n            + listarPedidos(): ResponseEntity&lt;List&lt;OrderResponseDTO&gt;&gt;\n            + obtenerPedidoPorId(id: Long): ResponseEntity&lt;OrderResponseDTO&gt;\n            + cancelarPedido(id: Long): ResponseEntity&lt;OrderResponseDTO&gt;\n        }\n\n        ProductController --&gt; ProductService\n        OrderController --&gt; OrderService\n    }\n\n    package \&quot;exception\&quot; {\n        class GlobalExceptionHandler {\n            + handleRecursoNoEncontrado(ex: RecursoNoEncontradoException): ResponseEntity&lt;Object&gt;\n            + handleStockInsuficiente(ex: StockInsuficienteException): ResponseEntity&lt;Object&gt;\n            + handlePrecioInvalido(ex: PrecioInvalidoException): ResponseEntity&lt;Object&gt;\n        }\n\n        class RecursoNoEncontradoException extends RuntimeException\n        class StockInsuficienteException extends RuntimeException\n        class PrecioInvalidoException extends RuntimeException\n    }\n}\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mcd7TLg154V1S8DOT3RE-1">
